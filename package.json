{
  "name": "nanocontext",
  "version": "1.0.0",
  "description": "AI-powered code context manager. AST-based chunking with vector search for AI agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nc": "dist/cli/index.js",
    "nanocontext": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rimraf dist",
    "test": "npm run build && node --test \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demirmusa/nanocontext.git"
  },
  "keywords": [
    "ai",
    "context",
    "ast",
    "tree-sitter",
    "vector-search",
    "mcp",
    "code-analysis",
    "llm"
  ],
  "author": "demirmusa",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/demirmusa/nanocontext/issues"
  },
  "homepage": "https://github.com/demirmusa/nanocontext#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@inquirer/prompts": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "openai": "^6.25.0",
    "tree-sitter-wasms": "^0.1.13",
    "vectordb": "^0.21.2",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
